# ============================================
# CNC Electric Knowledge Bot
# .env в Git НЕ коммитить (проверьте .gitignore)
# ============================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- РОЛИ: Telegram numeric ID через запятую ---
# Свой ID узнать у @userinfobot
# Приоритет: admin > director > engineer > manager. Кого нет в списках —
# доступа нет.
ADMIN_USER_IDS=
# Руководители: смотрят как менеджер + /stats, /status, /unanswered.
# Подпись можно задать рядом с ID через двоеточие — роль одна, а
# основатель и технический директор называются по-разному.
# Пример: DIRECTOR_USER_IDS=111:Руководитель CNC Electric,222:Технический директор
DIRECTOR_USER_IDS=
ENGINEER_USER_IDS=
MANAGER_USER_IDS=

# Канал, подписка на который делает человека клиентом (ARCHITECTURE.md §3).
# Бот обязан быть администратором этого канала, иначе проверка подписки
# невозможна и клиенты получают отказ.
CLIENT_CHANNEL=@cncelectric_russia

# --- API 1С: товары, цены, остатки, транзит ---
CNC_API_USERNAME=
CNC_API_PASSWORD=
# CNC_API_QUERY_PARAM пока не используется кодом (зарезервировано).
CNC_API_QUERY_PARAM=search

# --- Счета: раздел зарезервирован под Спринт 2 (см. README §«Ближайший план»). ---
# Ни один из ключей ниже пока не читается кодом — функция ещё не написана,
# не только заблокирована доступом 1С.
INVOICES_JSON_PATH=
INVOICES_STALE_HOURS=24
INVOICES_PERIOD_DAYS=180
MANAGER_SEES_ALL_INVOICES=true
SHOW_DEBT_WORDING=true
XLSX_RATE_LIMIT_PER_HOUR=5

# --- Поведение (тоже пока не читается кодом — зарезервировано) ---
QUESTIONS_PER_MINUTE=20

# --- Пути ---
DB_PATH=data/bot.db
# API_EXPORTS_DIR пока не используется кодом: путь data/api_exports зашит
# в catalog_search.py, knowledge_matrix.py и cnc_api.py напрямую.
API_EXPORTS_DIR=data/api_exports
UPLOADS_DIR=uploads
BACKUP_DIR=backups

# --- Почта технической службы ---
# Домен cncrussia.com обслуживается Mail.ru для бизнеса: SMTP_PASSWORD —
# «пароль для внешнего приложения», а не пароль входа в почту.
# Без этих настроек эскалация не ломается: вопрос всё равно доходит до
# инженера в Telegram, письменного следа просто не будет.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=help@cncrussia.com
SMTP_PASSWORD=
SUPPORT_EMAIL=help@cncrussia.com

# --- Расписание (МСК) ---
SYNC_PRODUCTS_HOUR=6
BACKUP_HOUR=3
# Обход вопросов клиентов, оставшихся без ответа третий рабочий день.
ESCALATION_REMINDER_HOUR=10

# --- Логи ---
LOG_LEVEL=INFO
# Срок хранения текста вопросов по политике; автоочистка query_log по этому
# сроку пока не реализована в коде (см. README §«Правовые замечания»).
ANALYTICS_RETENTION_DAYS=180
